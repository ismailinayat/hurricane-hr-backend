# Application
NODE_ENV=development
PORT=4010
CORS_ORIGINS=http://localhost:4020

# Database (either DATABASE_URL or the discrete DB_* vars below are used)
DATABASE_URL=postgresql://attendance:attendance@localhost:5432/attendance
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=attendance
DB_PASSWORD=attendance
DB_DATABASE=attendance
DB_SSL=false

# JWT
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRATION=1h

# Password reset
PASSWORD_RESET_EXPIRATION=15m

# Frontend URL used to build the reset-password link sent in emails
FRONTEND_URL=http://localhost:4020

# SMTP (leave SMTP_HOST unset to log reset emails to the console instead of sending them)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Attendance <no-reply@attendance.local>

# Seed (development only)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123
